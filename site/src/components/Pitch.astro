---
const cards = [
  { t: 'Rust/WASM parsers', d: 'DOCX, XLSX and PPTX parsing is implemented in Rust and compiled to WebAssembly.' },
  { t: 'Canvas rendering', d: 'Documents are rendered with the Canvas 2D API. Layout and feature support vary by format and document.' },
  { t: 'Specification-informed', d: 'The implementation refers to ECMA-376 / ISO 29500 and related Microsoft documentation where relevant.' },
  { t: 'Document APIs and viewers', d: 'Use built-in viewers or document APIs for custom previews, thumbnails and navigation.' },
];
---
<div class="pitch-grid">
  {cards.map((c) => (
    <div class="pitch-card">
      <h3>{c.t}</h3>
      <p>{c.d}</p>
    </div>
  ))}
</div>

<style>
  .pitch-grid { display: grid; grid-template-columns: repeat(12, 1fr); border-top: 1px solid var(--border-bright); }
  .pitch-card {
    grid-column: span 3;
    min-height: 274px;
    padding: 18px 22px 28px 0;
    border-right: 1px solid var(--border);
  }
  .pitch-card + .pitch-card { padding-left: 22px; }
  .pitch-card:last-child { border-right: 0; }
  .pitch-card h3 { max-width: 14ch; font-size: 19px; margin: 42px 0 12px; letter-spacing: -.035em; }
  .pitch-card p { font-size: 13.5px; color: var(--text-dim); margin: 0; line-height: 1.65; }
  @media (max-width: 900px) {
    .pitch-card { grid-column: span 6; border-bottom: 1px solid var(--border); }
    .pitch-card:nth-child(2) { border-right: 0; }
    .pitch-card:nth-child(3) { padding-left: 0; }
  }
  @media (max-width: 520px) {
    .pitch-card { grid-column: span 12; min-height: auto; padding: 18px 0 28px !important; border-right: 0; }
    .pitch-card h3 { margin-top: 20px; }
  }
</style>
