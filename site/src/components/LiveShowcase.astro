---
// Live Showcase — three viewers behind format tabs.
const formats = [
  { id: 'docx', label: 'DOCX' },
  { id: 'xlsx', label: 'XLSX' },
  { id: 'pptx', label: 'PPTX' },
];
---
<div class="showcase" data-showcase>
  <div class="panel">
    <div class="panel-head">
      <div class="tabs" role="tablist" aria-label="Document format">
        {formats.map((f, i) => (
          <button
            class="tab"
            role="tab"
            data-tab={f.id}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <span class="tab-label">{f.label}</span>
          </button>
        ))}
      </div>
      <span class="panel-file" data-file>sample-1.docx</span>
      <span class="panel-badge">live · WASM</span>
    </div>
    <div class="panel-body" data-mount></div>
  </div>
</div>

<script>
  import { mountPptx, mountDocx, mountXlsx, type LiveController } from '../lib/live';

  const base = import.meta.env.BASE_URL;
  const sample = (f: string) => `${base}samples/${f}`.replace(/([^:])\/\/+/g, '$1/');

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const mount = root.querySelector<HTMLElement>('[data-mount]')!;
    const fileLabel = root.querySelector<HTMLElement>('[data-file]')!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    let current: LiveController | null = null;
    let loaded: string | null = null;

    function show(id: string): void {
      if (loaded === id) return;
      loaded = id;
      root.dataset.format = id;
      current?.destroy();
      if (id === 'pptx') { fileLabel.textContent = 'sample-1.pptx'; current = mountPptx(mount, sample('sample-1.pptx')); }
      else if (id === 'docx') { fileLabel.textContent = 'sample-1.docx'; current = mountDocx(mount, sample('sample-1.docx')); }
      else { fileLabel.textContent = 'sample-1.xlsx'; current = mountXlsx(mount, sample('sample-1.xlsx')); }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        show(tab.dataset.tab!);
      });
    });

    // Lazy-mount the first tab when the showcase is near the viewport. Mount
    // immediately if it's already close; otherwise wait for it to scroll in.
    const first = tabs[0]?.dataset.tab ?? 'docx';
    const nearViewport = () => root.getBoundingClientRect().top < window.innerHeight + 600;
    if (nearViewport()) {
      show(first);
    } else {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { show(first); io.disconnect(); }
        }
      }, { rootMargin: '600px' });
      io.observe(root);
    }
  });
</script>

<style>
  .showcase { margin-top: 32px; }
  .tabs {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex: 0 0 auto;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elev-2);
  }
  .tab {
    display: inline-flex;
    align-items: center;
    min-height: 0;
    padding: 6px 10px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--text-dim);
    font: 600 12px var(--mono);
    cursor: pointer;
    transition: color .18s, background .18s;
  }
  .tab:hover { color: var(--text); background: var(--bg-elev); }
  .tab[aria-selected='true'] {
    color: var(--text);
    background: var(--border);
  }
  .panel {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--panel);
    overflow: hidden;
    box-shadow: var(--glow);
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .panel-file { margin-left: auto; font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .panel-badge {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--border-bright);
    border-radius: 0;
    padding: 3px 10px;
  }
  .panel-body { padding: 0; }
  .panel-body :global(.lv-scroll) { border-radius: 0; }
  .showcase[data-format='xlsx'] .panel-body :global(.lv-xlsx) { border-radius: 0; }
  @media (max-width: 620px) {
    .panel-file { display: none; }
    .panel-head { gap: 8px; }
    .panel-badge { margin-left: auto; }
  }
</style>
