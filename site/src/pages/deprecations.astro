---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import BrandIcon from '../components/BrandIcon.astro';

const rows = [
  {
    id: 'max-zip-entry-bytes',
    api: 'maxZipEntryBytes',
    surface: 'DOCX, XLSX, PPTX and Node load/session options',
    replacement: 'resourceLimits.maxArchiveEntryBytes',
    note: 'The compatibility alias preserves its existing per-entry behavior until removal.',
  },
  {
    id: 'ooxml-error-source',
    api: 'OoxmlErrorSource',
    surface: '@silurus/ooxml-core and all format entry points',
    replacement: 'OoxmlErrorStage',
    note: 'The old vocabulary was exposed briefly by the resource-governance API.',
  },
  {
    id: 'xlsx-chart-type-aliases',
    api: 'XlsxChartSeries, SeriesDataLabels, DataLabelOverride, DataPointOverride, ErrBars, ManualLayout',
    surface: '@silurus/ooxml/xlsx',
    replacement: 'ChartSeries, ChartSeriesDataLabels, ChartDataLabelOverride, ChartDataPointOverride, ChartErrBars and ChartManualLayout',
    note: 'Chart types now come from the shared core chart model.',
  },
  {
    id: 'wasm-parser-set-url',
    api: 'WasmParserHost.setWasmUrl()',
    surface: '@silurus/ooxml-core',
    replacement: 'WasmParserHost.setWasmInput()',
    note: 'The replacement accepts every supported WASM initializer input, not URLs only.',
  },
  {
    id: 'decoded-bitmap-cache',
    api: 'dropBitmapCacheByPath(), deferBitmapCloseWhileLeased()',
    surface: '@silurus/ooxml-core',
    replacement: 'dropDecodedBitmapCache() and the owned decoded/derived bitmap cache APIs',
    note: 'The replacement owns both base and derived decoded surfaces under one lifecycle.',
  },
] as const;
---

<Base title="Deprecated APIs — @silurus/ooxml" canonicalPath="/deprecations/">
  <Nav />
  <header class="dep-hero">
    <div class="wrap">
      <a class="back" href="/">← Documentation</a>
      <p class="eyebrow">API reference</p>
      <h1>Deprecated APIs.</h1>
      <p>Compatibility surfaces that remain available today, their replacements and the removal policy.</p>
    </div>
  </header>

  <main class="wrap dep-main">
    <section class="policy">
      <h2>Removal policy</h2>
      <p><strong>Every API listed below is scheduled for removal in a future breaking release.</strong> It will not be removed in a patch release. A migration notice will identify the exact release before removal.</p>
    </section>

    <section class="dep-list" aria-label="Deprecated API list">
      {rows.map((row) => (
        <article id={row.id} class="dep-row">
          <div class="dep-name"><code>{row.api}</code><span>{row.surface}</span></div>
          <div class="dep-migration">
            <p class="replace">Use <code>{row.replacement}</code>.</p>
            <p>{row.note}</p>
          </div>
        </article>
      ))}
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <BrandIcon />
        <div><strong>@silurus/ooxml</strong><span>Browser-based OOXML viewer · Rust/WASM + Canvas</span></div>
      </div>
      <div class="footer-links"><a href="/">Home</a><a href="/errors">Error reference</a><a href="https://github.com/yukiyokotani/office-open-xml-viewer">GitHub</a></div>
    </div>
  </footer>
</Base>

<style>
  .dep-hero { padding: 56px 0 52px; border-bottom: 1px solid var(--border); }
  .back { color: var(--text-faint); font-size: 13px; }
  .dep-hero .eyebrow { margin-top: 26px; }
  h1 { margin: 12px 0 0; font-size: clamp(38px, 7vw, 72px); letter-spacing: -.035em; }
  .dep-hero > .wrap > p:last-child { max-width: 68ch; margin: 18px 0 0; color: var(--text-dim); font-size: 17px; }
  .dep-main { padding-bottom: 72px; }
  .policy { padding: 44px 0; border-bottom: 1px solid var(--border); }
  .policy h2 { margin: 0 0 12px; font-size: 24px; }
  .policy p { max-width: 82ch; margin: 0; color: var(--text-dim); }
  .policy strong { color: var(--text); }
  .dep-list { border-bottom: 1px solid var(--border); }
  .dep-row { display: grid; grid-template-columns: minmax(260px, 4fr) minmax(0, 8fr); gap: 28px; padding: 30px 0; border-top: 1px solid var(--border); scroll-margin-top: 76px; }
  .dep-row:first-child { border-top: 0; }
  .dep-name { display: grid; align-content: start; gap: 10px; }
  .dep-name code { color: var(--accent); font: 600 13px/1.55 var(--mono); overflow-wrap: anywhere; }
  .dep-name span { color: var(--text-faint); font: 500 11px/1.5 var(--mono); }
  .dep-migration p { max-width: 74ch; margin: 0; color: var(--text-dim); }
  .dep-migration p + p { margin-top: 8px; }
  .dep-migration .replace { color: var(--text); font-weight: 700; }
  .dep-migration code { font-family: var(--mono); font-size: .9em; }
  @media (max-width: 700px) { .dep-row { grid-template-columns: 1fr; gap: 16px; } }
</style>
